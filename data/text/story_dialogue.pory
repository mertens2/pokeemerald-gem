// slateport city text
text SlateportCity_SternsShipyard_1F_Text_CantMakeHeadsOrTails {
	poryswitch(LANGUAGE) {
		EN{
			format("Umm… If this goes here, and that\n"
			"goes over there…\p"
			"Then where does this thing go?\n"
			"Arghh! This man and his doctor handwriting!")
		}
		ES{
			format("A ver… Si esto va aquí y aquello va allá…\p"
			"¿Dónde va esto entonces?\n¡Ahhh! ¡Ese tipo y su letra de doctor!")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_MeetDockDeliverToStern {
	poryswitch(LANGUAGE) {
		EN{
			format("Hm?\nHi, I'm Dock Muéllez.\p"
			"Captain Stern commissioned me to design a ferry.\p"
			"Oh! That there…\nAren't those some Devon Goods?\p"
			"Must be for him, the guy really needs them, couldn't stop mumbling about it.\p"
			"Wanna go give them to him? He must be on the Oceanic Museum searching for inspiration.")
		}
		ES{
			format("¿Eh?\nAh, hola, soy Dock Muéllez.\p"
			"El Capitán Stern me ha encargado que diseñe un ferry.\p"
			"Oh, eso de ahí…\n¿Son las Partes Devon?\p"
			"Deben ser para él. El tipo las NECESITA, no paraba de murmurarlo.\p"
			"¿Puedes ir a buscarlo? Creo que andaba por el Museo Océanico buscando inspiración.")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_CouldYouFindStern {
	poryswitch(LANGUAGE) {
		EN{
			format("DOCK: Where could CAPT. STERN have\n"
			"gone off to?\p"
			"Could you go find CAPT. STERN and\n"
			"deliver that parcel to him?")
		}
		ES{
			format("¿Que adónde puede haber ido el Capitán?\p"
			"¿Podrías ir a buscarlo y entregarle ese paquete?")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_CouldUseAdviceFromVeteran {
	poryswitch(LANGUAGE) {
		EN{
			format("Shipbuilding is an art.\p"
			"A lot of things can't be figured out just by calculating.\p"
			"I really could use advice from a hot veteran who knows his way round the seas…")
		}
		ES{
			format("Construir barcos es todo un arte.\p"
			"Hay mucho que no se resolver con cálculos.\p"
			"Cómo me gustaría que algún lindo lobo de mar me aconsejase…")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_BrineyJoinedUs {
	poryswitch(LANGUAGE) {
		EN{
			format("DOCK: Hi! MR. BRINEY's joined us to\n"
			"lend us his help.\p"
			"Thanks to the veteran sailor, the\n"
			"ferry is steadily coming together.")
		}
		ES{
			format("¡Hola! El Señor Briney se ha unido a nosotros.\p"
			"Gracias a su valiosísima ayuda, nuestro proyecto de ferry empieza a tomar forma.")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_FerryIsReady {
	poryswitch(LANGUAGE) {
		EN{
			format("DOCK: The ferry is finally ready!\p"
			"The new S.S. TIDAL is truly a marvel\n"
			"of technology!\p"
			"But, I get the feeling that we can\n"
			"make something even better.\p"
			"You know, there's never an end to\n"
			"technology's march.")
		}
		ES{
			format("¡El ferry está listo!\p"
			"¡El nuevo S.S. MAREA es toda una maravilla tecnológica!\p"
			"Sin embargo, creo que aún podemos mejorar el diseño.\p"
			"¡Ya sabes que el avance de la ciencia es imparable!")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_DecidedToHelpDock {
	poryswitch(LANGUAGE) {
		EN{
			format("MR. BRINEY: Ah, {PLAYER}{KUN}!\n"
			"It's been too long!\p"
			"Aye, since I met you, this old sea dog's\n"
			"been feeling frisky!\p"
			"So I've decided to help DOCK make\n"
			"a ferry.\p"
			"Aye, after all, a ferry would be able\n"
			"to carry a lot of people.\p"
			"But, you know, that DOCK is really\n"
			"something special.\p"
			"With his knack for technology and\n"
			"my experience, I'm sure that we can\l"
			"build one great ship, aye!")
		}
		ES{
			format("¡Anda, {PLAYER}{KUN}!\n¡Cuánto tiempo!\p"
			"Desde que te conocí, me he\n"
			"sentido la mar de inquieto.\p"
			"Así que he decidido ayudar a\n"
			"MUÉLLEZ a construir el ferry.\p"
			"¡Imagina cuánta gente podría\n"
			"transportar en cada viaje!\p"
			"¿Sabes? Este MUÉLLEZ es\n"
			"un tipo especial de verdad.\p"
			"Uniendo sus conocimientos\n"
			"y mi experiencia, haremos\l"
			"un gran barco, ¡ya lo creo!")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_SeaIsLikeLivingThing {
	poryswitch(LANGUAGE) {
		EN{
			format("The seasons, the weather, where\n"
			"the moon sits in the sky…\p"
			"These and other conditions make\n"
			"the sea change its expression.\p"
			"That's right!\n"
			"The sea is like a living thing!")
		}
		ES{
			format("Las estaciones, el tiempo,\n"
			"la posición de la Luna…\p"
			"El estado del mar se ve afectado\n"
			"por todo esto y mucho más.\p"
			"¡Exactamente!\n"
			"¡El mar tiene vida!")
		}
	}
}


text SlateportCity_SternsShipyard_1F_Text_GetSeasickEasily {
	poryswitch(LANGUAGE) {
		EN{
			format("I get seasick real easily.\n"
				"So I get to help out here instead.")
		}
		ES{
				format("Me entra mareo con nada…, así que\n"
				"me han destinado a este puesto.")
		}
	}
}

text SlateportCity_OceanicMuseum_2F_Text_ShouldI {
	format("{COLOR BLUE}(¿Debería dárselas...?)\p(Supongo que no hay de otra, dejando dudas de lado.){COLOR DARK_GRAY}")
}

text SlateportCity_OceanicMuseum_2F_Text_WeCantDoThat {
	format("¡Tienes sólo un Pokémon!\p¡No podemos atacar a alguien así!")
}

text SlateportCity_OceanicMuseum_2F_Text_WeCantBeatUp {
	format("¿Lo habrá hecho a propósito?\n¿Para que no l{OA} ataquen?\p¡Arceus, ¿qué pensará el Jefe?!\n¡Esas Partes son nuestras!")
}

text SlateportCity_OceanicMuseum_2F_Text_BeReady {
	format("Okay, Stern, cálmate. Todo estará bien...")
}

text SlateportCity_OceanicMuseum_2F_Text_ThankYouForTheParts {
	format("Ah, hola, ¿Eres {ELLA} repartidor{A}?\n"
	"Puedes dejarme las Partes por ahí, este lugar es peligroso ahora.")
}

text SlateportCity_OceanicMuseum_2F_Text_WellTakeThoseParts {
	format("{COLOR LIGHT_GRAY SHADOW WHITE}¿Cómo era? Ah, sí, ok. {COLOR DARK_GRAY SHADOW LIGHT_GRAY}\p¡Alto ahí, señores!\n"
	"¡Nos llevaremos esas Partes!")
}

text SlateportCity_OceanicMuseum_2F_Text_SternWhoAreYou {
	format("¡Oh! ¡Eh! ¿Qué?\n"
	"¿Q-quiénes son?")
}

text SlateportCity_OceanicMuseum_2F_Text_WereTeamAqua {
	format("¡Somos el Equipo Aqua!\p"
	"¡Y nuestro Jefe nos envió a buscar esas Partes!")
}

text SlateportCity_OceanicMuseum_2F_Text_Grunt1Defeat {
	format("¡Aaaahh!\n"
	"¡Me ganó un{A} niñ{OA}!")
}

text SlateportCity_OceanicMuseum_2F_Text_BossGoingToBeFurious {
	format("¿Porqué tenía que pasar esto…?\n"
	"El Jefe no estará complacido…")
}

text SlateportCity_OceanicMuseum_2F_Text_LetMeTakeCareOfThis {
	format("¡Pedazo de idiota!\n"
	"¡Se suponía que atacáramos juntos!\p"
	"¡Ven conmigo, aún con esos Pokémon débiles de tus reservas seremos más fuertes!")
}
text SlateportCity_OceanicMuseum_2F_Text_LetMeTakeCareOfThis2 {
	format("¡Prerárate!")
}

text SlateportCity_OceanicMuseum_2F_Text_Grunt2Defeat {
	format("Recluta 1: ¡¿QUÉ?!\n"
	"Recluta 2: ¡Ja! El problema\lno era yo.")
}

text SlateportCity_OceanicMuseum_2F_Text_MeddlingKid {
	format("¿Ahora qué? Se supone que las Partes\n"
	"son nuestras, ¡Esto es injusto!")
}

text SlateportCity_OceanicMuseum_2F_Text_CameToSeeWhatsTakingSoLong {
	format("Sabía que no se podía confiar en Stern, ¿pero en ustedes?\p"
	"¡No pensé que perderían ante un{A} niñ{OA}!")
}

text SlateportCity_OceanicMuseum_2F_Text_ArchieWarning {
	format("¡Escúchame bien, vamos a cambiar el mundo!\p"
	"¡Yo, {COLOR BLUE}el Líder del Equipo{COLOR DARK_GRAY},\n"
	"{COLOR BLUE}el Grandioso Archie{COLOR DARK_GRAY}, te lo aseguro!")
}
text SlateportCity_OceanicMuseum_2F_Text_ArchieWarning2 {
	format("En pocos años, llegaremos {COLOR BLUE}a un punto sin retorno{COLOR DARK_GRAY}, uno donde nuestras acciones dejarán este mundo inhabitable.\p"
	"Todos aquí en Slateport lo saben, ¡Pero mi Equipo Aqua salvará el mundo!\p"
	"Tengo que admitirlo…\pTienes agallas por meterte con nosotros, ¡Pero para la próxima, te dejaré naufragando!")
}
text SlateportCity_OceanicMuseum_2F_Text_ArchieWereLeaving {
	format("¡Ahora, ustedes dos!\n¡Nos vamos!\p"
	"Díganle a todos que nos vamos a las aguas termales, lo merecen.\p"
	"Algo me dice que ya recuperaremos las Partes.")
}

text SlateportCity_OceanicMuseum_2F_Text_SternThankYouForSavingUs {
	format("Ese {COLOR BLUE}Equipo Aqua{COLOR DARK_GRAY}… …\n"
	"¡Entrar a la fuerza y atacar a un{A} niñ{OA}!\p"
	"No puedo creer que esta ciudad esté tan de acuerdo con criminales que dicen “ayudar,”\l"
	"¡Cuando en verdad son un peligro!\p"
	"Pero bueno, ¡Me llevaré las Partes, gracias!")
}

text SlateportCity_OceanicMuseum_2F_Text_SternIveGotToGo {
	format("Estas Partes son necesarias para la construcción de un {COLOR BLUE}submarino{COLOR DARK_GRAY} que inventé…")
}
	

//mauville

text MauvilleCity_Text_UncleHesTooPeppy {
	format("Mi Wally se emociona mucho, gracias a\n"
	"los Pokémon.\p"
	"Me parece que es mucha emoción…")
}

text MauvilleCity_Text_WallyWantToChallengeGym {
	format("¡Ay, porfa, Tío, déjame tomar el {COLOR BLUE}Desafío\n"
	"de los Gimnasios{COLOR DARK_GRAY}, ya soy muy fuerte!\p"
	"¡Ralts y yo aprendimos técnicas súper\n"
	"fuertes!")
}

text MauvilleCity_Text_UncleYourePushingIt {
	format("Wally, Wally, tranquilo.\p"
	"¿No te estás precipitando?{PAUSE 2} Entiendo\n"
	"que se hayan fortalecido, pero los\l"
	"{COLOR BLUE}Líderes de Gimnasio{COLOR DARK_GRAY} son MUY fuertes…")
}

text MauvilleCity_Text_WallyWeCanBeatAnyone {
	format("¡No me estoy precipitando, Tío!\p"
	"Si Ralts me ayuda, {PAUSE 5}¡Podré vencer a\n"
	"cualquier rival!")
}

text MauvilleCity_Text_WallyWillYouBattleMe {
	format("Ah, {PAUSE 2}¡{PLAYER}, {PLAYER}!\p"
	"¡Hace tanto que no te veo, amig{OA}!\p"
	"¡{PLAYER}, {PLAYER}, quiero\n"
	"mostrarte lo fuerte que me he vuelto!\l"
	"Mi Ralts hasta ha aprendido muchos\l"
	"ataques nuevos, {PLAYER}.\p"
	"¿Te gustaría combatir conmigo,\n"
	"{PLAYER}, por favor?")
}

text MauvilleCity_Text_WallyMyUncleWontKnowImStrong {
	format("Pero… {PAUSE 5}Pero si no combatimos, mi Tío no\n"
	"me dejará combatir en los Gimnasios…")
}

text MauvilleCity_Text_UncleCanYouBattleWally {
	format("{PLAYER}, {PAUSE 2}¿Verdad?\p"
	"Wally te admira muchísimo, y no querrá\n"
	"irse de aquí hasta que tengan una\l"
	"batalla, así que, por favor, por su bien\l"
	"y por el mío, {PAUSE 2}¿Podrías hacerlo?")
}

text MauvilleCity_Text_WallyPleaseBattleMe {
	format("¡Porfa, {PLAYER}, porfa!")
}

text MauvilleCity_Text_WallyHereICome {
	format("Gracias, muchas gracias.\p"
	"-inhala-, -suspira-… Entonces…\p"
	"¡{PLAYER}, t-{PAUSE 1}te desafío a una {PLAY_SE SE_PIN}Batalla\n"
	"Pokémon!{WAIT_SE}")
}

text MauvilleCity_Text_WallyDefeat {
	format("Wally: … {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}…\p"
	"… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}…\p"
	"Perdí…\pY en frente de {PLAYER}…")
}

text MauvilleCity_Text_WallyIllGoBackToVerdanturf {
	format("T-{PAUSE 2}tío… {PAUSE 5}Q-{PAUSE 2}quiero… Ir a Verdanturf…\p"
	"… … … … …")
}

text MauvilleCity_Text_ThankYouNotEnoughToBattle {
	format("… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}…\p"
	"G-{PAUSE 2}gr…{PAUSE 2}{TEXT_SPEED 2}gra…{PAUSE 2}gracias, {PLAYER}…\p"
	"{TEXT_SPEED 0}Y-{PAUSE 2}yo… {PAUSE 5}R-{PAUSE 2}realme… {PAUSE 5}…{PAUSE 1}…{PAUSE 1}…{PAUSE 1}… {PAUSE 5}{TEXT_SPEED 2}Aprecio\n"
	"que… {PAUSE 5}{TEXT_SPEED 2}Te hayas tomado el tiempo de\l"
	"{TEXT_SPEED 0}enseñarme que ser Entrenador se trata\l"
	"de mucho más que subir unos niveles…\p"
	"Necesito…\n"
	"… {PAUSE 5}…\l"
	"… {PAUSE 5}{TEXT_SPEED 3}Talento, {PAUSE 2}¿Verdad?")
}

text MauvilleCity_Text_UncleNoNeedToBeDown {
	format("¿Ves, Wally? Tu padre tiene razón.\p"
	"No puedes con esto, es demasiado para tí.\p"
	"No quiero que seguir perdiendo de lastime aún más.\p"
	"Deja esta locura de ser Entrenador, Wally.")
}
	
text MauvilleCity_Text_WallyNoNeedTo {
	format("{TEXT_SPEED 2}Iré solo a Verdanturf.\pNecesito pensar, Tío.")
}

text MauvilleCity_Text_WallysUncleItsOkay {
	format("Está bien, Wally.\nCuídate mucho.")
}

text MauvilleCity_Text_UncleVisitUsSometime {
	format("… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}…\p"
	"Esto es lo que temíamos, {PLAYER}, Wally no soporta la derrota…\p"
	"… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}… {PAUSE 5}…\p"
	"Espero que esto al menos le ayude a despertarse.\N"
	"Ahora dejará esto de lado, y la derrota no lo lastimará más. Gracias, {PLAYER}.")
}

text MauvilleCity_Text_WallyPokenavCall {
	format("… … … … … …\n"
	"… … … … … {PAUSE 2}¡Biip!\p"
	"Wally: ¡H-{PAUSE 2}hola, {PLAYER}!\p"
	"Q-{PAUSE 2}quería decirte que mi Tío me compró un PokéNav.\p"
	"Ahora podré hablar contigo un poco más seguido.\p"
	"C-{PAUSE 2}c-{PAUSE 2}c-{PAUSE 2}c-{PAUSE 2}claro, s-{PAUSE 2}si eso n-{PAUSE 2}no te parece m-{PAUSE 2}molesto…\p"
	"…\p"
	"¿Te parece bien?\N"
	"¡Genial!\p"
	"¡Hablamos luego, {PLAYER}!\p"
	"… … … … … …\n"
	"… … … … … {PAUSE 2}¡Click!", maxLineLength=32)
}

text MauvilleCity_Text_RegisteredWally {
	format("Has añadido a Wally\n"
	"al PokéNav.")
}

text MauvilleCity_Text_ScottAParentShould {
	format("Oiga, con el debido respeto,\n{COLOR LIGHT_GRAY SHADOW WHITE}osea, ninguno,{COLOR DARK_GRAY SHADOW LIGHT_GRAY}\N"
		   "¿Quién se cree usted para hablarle así a UN NIÑO? ¿Sobretodo su propio sobrino?\p"
		   "No quiero faltar el respeto, sir, pero un tío debería apoyar a su sobrino, no tirarlo abajo del modo que lo hizo.")
}

text MauvilleCity_Text_AndWhoAreYou {
	format("¿Y quién es usted para decirme cómo tratar a mi sobrino?")
}

text MauvilleCity_Text_ImScott {
	format("¿Yo?\pI'm Scott, el {COLOR BLUE}inventor de las Tiendas Batalla{COLOR DARK_GRAY}.\p"
			"Ah, y más importante para usted, un{COLOR BLUE} antiguo Alto Mando de Hoenn{COLOR DARK_GRAY}.")
}

text MauvilleCity_Text_AndWhyDoICare {
	format("¿Y eso por qué me tiene que importar a mí?")
}

text MauvilleCity_Text_ScottDefendsWally {
	format("Porque digamos que viví lo mismo que Wally, y por experiencia le digo que tratar de “proteger” a un familiar del fracaso…\p"
			"… Lo lastimará más que la más aplastante derrota. ¿Acaba de perder y usted le dice que no sirve para esto?\p"
			"¿Qué clase de adulto cree que eso ayudará a su sobrino?")
}

text MauvilleCity_Text_YouDontUnderstand {
	format("Usted no lo entiende, Wally es… “Especial,” no podemos dejarlo sin supervisión.\p"
			"Y veo que no cambiaré su parecer, así que me voy.")
}

text MauvilleCity_Text_Although {
	format("… … … … … Aunque…\p"
			"… Se ve bastante feliz junto a los Pokémon…\p"
			"Debería hablar con su padre sobre esto, y detenrlo de…")
}

text MauvilleCity_Text_ScottBadFamily {
	format("Lo peor de los familiares como él, es que vienen de un lugar de preocupación.\p"
			"Don't wanna assume, pero parece que su padre es peor…")
}

text MauvilleCity_Text_ScottYoureTheRealDeal {
	format("Anyways…\p"
			"Parece que en serio eres buen{OA} en esto, ¿y buen{A} amig{OA}, también?\p"
			"Espero sigas mejorando, ¡Estaré esperando ver en quién se convierten ambos!")
}


