
script Debug_Script_1 {
	setflag (FLAG_SYS_POKEDEX_GET)
    setflag (FLAG_SYS_POKEMON_GET)
    setflag (FLAG_SYS_POKENAV_GET)
	setflag (FLAG_MENU_DEXRELATED)
	setflag (FLAG_SYS_DEXNAV_GET)
	setflag (FLAG_SYS_QUEST_MENU_GET)
	setflag (FLAG_ENABLED_PC)
	if (!flag(FLAG_SHINY_CREATION)){
		setflag(FLAG_SHINY_CREATION)
	}
	else {
		clearflag(FLAG_SHINY_CREATION)
	}
	clearflag(FLAG_NO_SHINIES)
	releaseall
	end
}

script Debug_Script_GiveAllDecor {
	lockall
	msgbox(format("Dando decoraciones{TEXT_SPEED 2}.........."))
	setvar(VAR_0x8004, 120)
	while (var(VAR_0x8004) > 0) {
		setflag(FLAG_TEMP_1)
		givedecoration(VAR_0x8004)
		subvar(VAR_0x8004, 1)
	}
	msgbox(format("¡{PLAY_SE SE_PIN}Listo! ¡Se han añadido todas las decoraciones!"))
	closemessage
	releaseall
}

